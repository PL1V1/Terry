# Terry — example configuration.
# Copy to .env and fill in. NEVER commit the real .env; it is gitignored.

# ---------------------------------------------------------------- Discord ---

# Bot token from the Discord Developer Portal (Bot -> Reset Token).
# Use a SEPARATE bot application from any other bot you run. Two clients sharing
# a token fight over the presence indicator.
DISCORD_TOKEN=

# The bot application's id (Developer Portal -> General Information -> App ID).
# Used before the Gateway hands over the real one on connect.
DISCORD_APPLICATION_ID=

# ------------------------------------------------------------- Allowlists ---
# Comma or space separated Discord snowflakes.
# The service refuses to start if ALLOWED_CHANNELS or OPERATORS is empty.
# An empty allowlist is a mistake, not an open door.

# Channels the service will answer in.
ALLOWED_CHANNELS=

# Users permitted to issue commands and queue work. Everyone else is ignored.
OPERATORS=

# Other bots this one will hold a conversation with, by bot user id. Empty means
# none, which refuses every bot exactly as before. Being a bot is not a
# credential: each peer is named here or it is ignored.
#
# A peer may talk. It may not use the commands - it cannot sleep, stop, or
# repoint the room, and it cannot wake a sleeping one. A human opens the room
# before two agents can use it.
PEER_AGENTS=

# How many turns in a row a peer may take before the room stops and waits for a
# human. Two mention-triggered agents answer each other indefinitely otherwise,
# and the bill for that lands on two people who are asleep. Any operator message
# refills it. Default 6.
PEER_TURN_LIMIT=

# Optional. Restrict to these servers as well. Empty means any server that
# contains an allowlisted channel.
ALLOWED_GUILDS=

# --------------------------------------------------------------- Runtime ---

# Path to the coding runtime binary.
CLAUDE_BIN=claude

# Working directory handed to the runtime. This is the codebase it can see.
# Point it at the project you want worked on, not at Terry's own source.
WORKSPACE_DIR=

# Optional starting model and effort. Both are also settable per room from
# Discord. Leave blank to use the runtime's own defaults.
# Run `bun run src/index.ts` once and use `@Terry list models` to see what the
# installed runtime advertises.
DEFAULT_MODEL=
DEFAULT_EFFORT=

# ----------------------------------------------------------- Permissions ---
#
# THIS IS THE SETTING THAT MATTERS. It decides what the runtime may do, and it
# is deliberately NOT changeable from Discord.
#
# Validated at startup against the modes the installed runtime actually accepts.
# For Claude Code 2.1.x those are:
#   plan               read and reason only; no writes, no shell   (default)
#   acceptEdits        may edit files without asking
#   auto               decides for itself
#   manual             asks for each action
#   dontAsk            does not ask
#   bypassPermissions  no checks at all
#
# PERMISSION_PROMPTS decides who answers a prompt: "host" or "none".
# "none" fails closed — an action needing approval is refused, not granted.
#
# The shipped default (plan + none) can read a codebase and answer questions but
# cannot change anything. Widen it deliberately, knowing what you are granting.
PERMISSION_MODE=plan
PERMISSION_PROMPTS=none

# -------------------------------------------------------------- Service ---

# SQLite file. Created on first run along with its directory.
DATABASE_PATH=./data/terry.sqlite

# How many recent channel messages are supplied as background context on the
# first turn of a conversation. 0 disables it.
# What a room does when an instruction changes after its conversation started.
# Instructions otherwise resolve live on every turn, which rewrites the rules of
# a running conversation with nothing said.
#
#   hold  keep the versions the conversation was minted with, and report the
#         change. Adopt it with `@Terry accept instructions`. (default)
#   live  adopt the change immediately, and report that it did.
#   off   no pinning; resolve live every turn, as it worked before pinning.
INSTRUCTION_DRIFT_POLICY=

HISTORY_LIMIT=25

# Whether a restart leaves awake rooms awake.
#
# Off by default, and deliberately so: a restart returns every room to asleep,
# keeping the conversation mapping and preferences so that waking a room picks
# it straight back up. A service that came back up and silently resumed work
# nobody asked for would be a nasty surprise after an unattended reboot.
#
# Only "true" enables it. Anything else is off.
RESUME_AWAKE_ON_RESTART=false

# debug | info | warn | error
LOG_LEVEL=info
