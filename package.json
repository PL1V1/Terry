{
  "name": "terry",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent Discord control room for a coding-agent session",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "migrate": "bun run src/db/migrate.ts up",
    "migrate:down": "bun run src/db/migrate.ts down",
    "migrate:status": "bun run src/db/migrate.ts status",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "admin": "bun run src/admin.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^7.0.2"
  }
}
